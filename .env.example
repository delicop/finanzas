# Copia este archivo a .env y cambia los valores.
# .env NUNCA se sube a git.

APP_ENV=development

# Puertos en el HOST (cambialos si ya tienes algo corriendo ahi).
# Dentro de Docker los servicios siempre usan 5432/8080/5173.
DB_PORT_HOST=5436
API_PORT_HOST=8080
WEB_PORT_HOST=5173

POSTGRES_USER=finanzas
POSTGRES_PASSWORD=cambia_esta_clave
POSTGRES_DB=finanzas

# Genera uno con: openssl rand -base64 48
JWT_SECRET=cambia_este_secreto_por_uno_largo_y_aleatorio
JWT_EXPIRY_HOURS=24

# Token para revisar la bitacora de errores desde afuera (curl).
# Es APARTE del login del cliente a proposito: asi el cliente no puede
# llegar a esas rutas. Si lo dejas vacio, las rutas no existen.
# Genera uno con: openssl rand -base64 24
TOKEN_MANTENIMIENTO=genera_uno_con_openssl_rand_base64_24

# --- Asistente (chat con IA) ---------------------------------------------
# Sin LLM_API_KEY el chat no existe: la app arranca igual y la ruta /api/agente
# no se monta. Es lo mismo que pasa con TOKEN_MANTENIMIENTO.
#
# La URL es de una API compatible con la de OpenAI, o sea que sirven tanto
# DeepSeek como OpenRouter; incluye la version (termina en /v1):
#   DeepSeek    LLM_BASE_URL=https://api.deepseek.com/v1   LLM_MODELO=deepseek-chat
#   OpenRouter  LLM_BASE_URL=https://openrouter.ai/api/v1  LLM_MODELO=deepseek/deepseek-chat
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODELO=deepseek-chat

# Segundos de espera al modelo. Tiene que ser menor que los 30s a los que el
# router corta la peticion, o el usuario veria un error generico.
LLM_TIMEOUT_SEGUNDOS=25

# Mensajes que puede mandar CADA usuario en 24 horas. Cada uno cuesta plata:
# sin techo, un cliente con un script deja la factura del mes en la mano.
LLM_LIMITE_DIARIO=50

# Origenes permitidos para CORS, separados por coma
CORS_ORIGINS=http://localhost:5173

# URL del backend vista DESDE EL NAVEGADOR (no desde dentro del contenedor)
VITE_API_URL=http://localhost:8080
